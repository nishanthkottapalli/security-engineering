# FastAPI lab
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-value
APP_ACCESS_TOKEN_MINUTES=30
APP_DATABASE_URL=postgresql+psycopg://secops:secops@postgres:5432/secops
APP_UPLOAD_DIR=/data/uploads
APP_MAX_UPLOAD_BYTES=5242880
APP_ALLOWED_UPLOAD_TYPES=text/plain,application/json,application/pdf
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=ChangeMe-Now-123!
APP_WORKER_POLL_SECONDS=2
APP_AUDIT_LOG_PATH=/data/audit/audit.jsonl

# Docker Compose
POSTGRES_DB=secops
POSTGRES_USER=secops
POSTGRES_PASSWORD=secops
API_PORT=8000
GATEWAY_PORT=8080

# AWS Terraform execution (only required for real apply)
AWS_REGION=ap-south-1
TF_VAR_project_name=security-capabilities-lab
TF_VAR_environment=lab
